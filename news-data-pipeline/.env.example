# OpenAI API key for summarize/analyze commands.
# Leave empty to run the rest of the pipeline (fetch/clean/report/export) without AI.
OPENAI_API_KEY=your_api_key_here

# Optional: point at an OpenAI-compatible gateway/proxy instead of api.openai.com.
# Leave unset to use the default OpenAI endpoint.
OPENAI_BASE_URL=
